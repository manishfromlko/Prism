# Required
OPENAI_API_KEY=

# OpenAI models
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
PROFILE_LLM_MODEL=gpt-4o-mini

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kubeflow_artifacts

# Backend runtime
INGESTION_CATALOG_PATH=../data/workspaces/.ingestion/ingestion_catalog.json
PLATFORM_DOCS_DIR=../data/platform_documents
CHAT_AGENT_MODE=orchestrated
AGENT_MAX_STEPS=4
AGENT_ENABLE_PLANNER_LLM=false

# LangSmith tracing, optional
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-chatbot-legacy

# MLflow tracing, local/free
MLFLOW_TRACING=true
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=rag-chatbot-legacy

